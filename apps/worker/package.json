{
  "name": "@pointshub/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js -c jest.int.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/schedule": "12.0.2",
    "@pointshub/db": "workspace:*",
    "@pointshub/shared": "workspace:*",
    "amqplib": "2.2.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.12",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.1",
    "@pointshub/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/rabbitmq": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  }
}
