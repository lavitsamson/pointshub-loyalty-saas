{
  "name": "pointshub",
  "private": true,
  "description": "Multi-tenant loyalty and rewards SaaS for small businesses",
  "license": "MIT",
  "author": "Lavit Samson",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "perf:customers": "pnpm --filter @pointshub/api bench:customers",
    "screenshots": "turbo run screenshots --filter=@pointshub/web",
    "format": "prettier --write apps packages docs deploy .github README.md \"*.{json,yaml,yml,mjs}\"",
    "format:check": "prettier --check apps packages docs deploy .github README.md \"*.{json,yaml,yml,mjs}\"",
    "db:migrate": "pnpm --filter @pointshub/db migrate:dev",
    "db:deploy": "pnpm --filter @pointshub/db migrate:deploy",
    "db:seed": "turbo run seed --filter=@pointshub/db",
    "db:seed:perf": "turbo run seed:perf --filter=@pointshub/db",
    "db:setup": "pnpm db:deploy && pnpm db:seed",
    "db:studio": "pnpm --filter @pointshub/db studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
