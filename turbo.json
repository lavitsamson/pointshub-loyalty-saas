{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "RABBITMQ_URL",
    "TESTCONTAINERS_*",
    "DOCKER_HOST",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "seed": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "seed:perf": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    }
  }
}
