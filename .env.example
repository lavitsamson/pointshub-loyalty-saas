# Copy to .env and adjust as needed. Every value here works with `docker compose up -d`.

NODE_ENV=development

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL=postgresql://pointshub:pointshub@localhost:5432/pointshub?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://pointshub:pointshub@localhost:5672

# --- API --------------------------------------------------------------------
API_PORT=4000
# Origin allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000
# Proxies in front of the API. The web app forwards /api/v1 to the API, which is one hop.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# --- Auth -------------------------------------------------------------------
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Browsers drop Secure cookies on plain http outside localhost; keep true anywhere with TLS.
COOKIE_SECURE=false

# --- Email (Mailpit locally: http://localhost:8025) ---------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=PointsHub <no-reply@pointshub.local>

# --- Worker -----------------------------------------------------------------
# Also uses WEB_ORIGIN (links in customer emails) and the email settings above.
# How often the outbox relay checks for new events, in milliseconds.
OUTBOX_POLL_INTERVAL_MS=1000
# Delay before each of the 5 retries of a failed message, in milliseconds; then it is dead-lettered.
CONSUMER_RETRY_DELAYS_MS=1000,5000,30000,120000,600000

# --- Web --------------------------------------------------------------------
# The browser only talks to the web origin; Next.js forwards /api/v1/* here, so session
# cookies stay first-party.
API_URL=http://localhost:4000
