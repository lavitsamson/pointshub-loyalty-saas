# Copy to deploy/.env on the server. Generate each secret with:
#   openssl rand -hex 32
# (hex keeps the passwords safe inside the connection URLs built in compose.yml)

# Public hostnames; both need DNS A/AAAA records pointing at the server.
DOMAIN=pointshub.example.com
INBOX_DOMAIN=mail.pointshub.example.com

POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET=

# Optional: Stripe test mode. All three or none (see README, "Billing").
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
