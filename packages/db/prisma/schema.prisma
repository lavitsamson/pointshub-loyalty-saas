// PointsHub data model.
//
// Conventions:
// - Every tenant-owned table carries `tenantId` and has an index that starts with it.
// - Primary keys are UUID v7 (time-ordered, so B-tree inserts stay append-friendly).
// - `PointsLedgerEntry` is append-only; balances are derived from it and cached on `Customer`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum LedgerEntryType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSAL
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

model Tenant {
  id                   String   @id @default(uuid(7)) @db.Uuid
  name                 String
  slug                 String   @unique
  plan                 Plan     @default(FREE)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  /// Mirrors the Stripe subscription status (active, past_due, canceled, ...).
  subscriptionStatus   String?
  /// End of the paid period: the renewal date, or the last day of Pro once cancelled.
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships    Membership[]
  invitations    Invitation[]
  customers      Customer[]
  loyaltyProgram LoyaltyProgram?
  tiers          Tier[]
  campaigns      Campaign[]
  purchases      Purchase[]
  ledgerEntries  PointsLedgerEntry[]
  rewards        Reward[]
  redemptions    Redemption[]
  auditLogs      AuditLog[]
  outboxEvents   OutboxEvent[]
  dailyStats     DailyStats[]
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased.
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

/// A pending or settled invitation to join a tenant. The emailed link carries a signed token
/// naming this row; the row makes the link single-use and revocable.
model Invitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @db.Uuid
  /// Stored lower-cased.
  email           String
  role            Role
  invitedByUserId String    @db.Uuid
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, email])
}

/// Refresh tokens for both merchant users and portal customers (exactly one owner is set).
/// Each use revokes the token and issues a successor in the same family;
/// presenting an already-revoked token revokes the whole family.
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String?   @db.Uuid
  customerId String?   @db.Uuid
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Loyalty programme
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @db.Uuid
  /// Stored lower-cased.
  email          String
  name           String
  phone          String?
  /// Set once the customer registers for the portal.
  passwordHash   String?
  tags           String[] @default([])
  currentTierId  String?  @db.Uuid
  /// Cached SUM(points) of the customer's ledger entries.
  pointsBalance  Int      @default(0)
  lifetimePoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentTier   Tier?               @relation(fields: [currentTierId], references: [id], onDelete: SetNull)
  purchases     Purchase[]
  ledgerEntries PointsLedgerEntry[]
  redemptions   Redemption[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, currentTierId])
  // The customer list's other keyset orders (sort value, then id), so a page reads ~25 rows.
  @@index([tenantId, name, id])
  @@index([tenantId, pointsBalance(sort: Desc), id(sort: Desc)])
  // Substring search (ILIKE '%term%') and tag filters; needs the pg_trgm extension.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
}

model LoyaltyProgram {
  id                    String   @id @default(uuid(7)) @db.Uuid
  tenantId              String   @unique @db.Uuid
  pointsPerCurrencyUnit Decimal  @db.Decimal(10, 4)
  /// ISO 4217 code; one currency per tenant in v1.
  currency              String   @db.Char(3)
  /// Null means points never expire.
  pointsExpiryMonths    Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Tier {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @db.Uuid
  name              String
  minLifetimePoints Int
  multiplier        Decimal  @db.Decimal(4, 2)
  sortOrder         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([tenantId, name])
  @@index([tenantId, minLifetimePoints])
}

model Campaign {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  multiplier Decimal  @db.Decimal(4, 2)
  startsAt   DateTime
  endsAt     DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, startsAt, endsAt])
}

model Purchase {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @db.Uuid
  customerId       String   @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @db.Char(3)
  recordedByUserId String   @db.Uuid
  externalRef      String?
  idempotencyKey   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ledgerEntries PointsLedgerEntry[]

  @@unique([tenantId, idempotencyKey])
  // Leads with the customer for the same reasons as on PointsLedgerEntry.
  @@index([customerId, createdAt])
  @@index([tenantId, createdAt])
}

/// Append-only. Rows are never updated or deleted; corrections are new entries.
model PointsLedgerEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @db.Uuid
  customerId      String          @db.Uuid
  type            LedgerEntryType
  /// Signed: positive for EARN/REVERSAL, negative for REDEEM/EXPIRE, either for ADJUST.
  points          Int
  balanceAfter    Int
  purchaseId      String?         @db.Uuid
  redemptionId    String?         @db.Uuid
  reason          String?
  /// Set on EARN entries when the programme has an expiry period.
  expiresAt       DateTime?
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purchase   Purchase?   @relation(fields: [purchaseId], references: [id])
  redemption Redemption? @relation(fields: [redemptionId], references: [id])

  // Customer ids are unique, so this serves a customer's history (tenantId is then a cheap
  // filter) and also the per-row lookups when a business and its customers are deleted.
  @@index([customerId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, expiresAt])
  // Foreign keys: without these, every deleted purchase or redemption scans the whole ledger.
  @@index([purchaseId])
  @@index([redemptionId])
}

model Reward {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String
  pointsCost  Int
  /// Null means unlimited.
  stock       Int?
  active      Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions Redemption[]

  @@index([tenantId, active])
}

model Redemption {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @db.Uuid
  customerId  String           @db.Uuid
  rewardId    String           @db.Uuid
  pointsSpent Int
  status      RedemptionStatus @default(PENDING)
  /// Short code the customer shows at the counter, e.g. "K7Q-4MP".
  code        String
  fulfilledAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward        Reward              @relation(fields: [rewardId], references: [id])
  ledgerEntries PointsLedgerEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, rewardId])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

/// Transactional outbox: written in the same transaction as the change it describes,
/// then published to RabbitMQ by the worker's relay.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  type        String
  payload     Json
  occurredAt  DateTime  @default(now())
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([publishedAt, occurredAt])
}

/// Consumer-side idempotency: one row per (consumer, event) successfully handled.
model ProcessedEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  consumer  String
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consumer, eventId])
}

model StripeWebhookEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DailyStats {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @db.Uuid
  date           DateTime @db.Date
  pointsEarned   Int      @default(0)
  pointsRedeemed Int      @default(0)
  newCustomers   Int      @default(0)
  purchases      Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}
